<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/options_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:fillViewport="true"
    tools:context=".ui.options.OptionsFragment">

    <LinearLayout
        android:id="@+id/options_fragment_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/main_fragment_options"
            android:textAppearance="@style/TextAppearance.AppCompat"
            android:textSize="@dimen/_36ssp" />

        <LinearLayout
            android:id="@+id/options_fragment_device_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/options_fragment_device_settings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/options_fragment_device_settings"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:id="@+id/options_fragment_device_settings_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/options_fragment_device_settings_desc"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/options_fragment_open_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/options_fragment_open_keyboard_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/options_fragment_open_keyboard"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/options_fragment_open_keyboard_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/options_fragment_open_keyboard_desc"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/options_fragment_open_keyboard_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/options_fragment_icon_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/options_fragment_icon_style_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/options_fragment_icon_style"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/options_fragment_icon_style_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/options_fragment_icon_style_desc"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/options_fragment_home_fade_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/options_fragment_home_fade"
            android:textAppearance="@style/TextAppearance.AppCompat"
            android:textSize="@dimen/_20ssp" />

        <TextView
            android:id="@+id/options_fragment_home_fade_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/options_fragment_home_fade_desc"
            android:textAppearance="@style/TextAppearance.AppCompat"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/options_fragment_home_fade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="100" />

        <TextView
            android:id="@+id/options_fragment_drawer_blur_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/options_fragment_drawer_blur"
            android:textAppearance="@style/TextAppearance.AppCompat"
            android:textSize="@dimen/_20ssp" />

        <TextView
            android:id="@+id/options_fragment_drawer_blur_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/options_fragment_drawer_blur_desc"
            android:textAppearance="@style/TextAppearance.AppCompat"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/options_fragment_drawer_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50" />

        <LinearLayout
            android:id="@+id/options_fragment_icon_packs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/options_fragment_icon_packs_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/options_fragment_icon_packs"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:id="@+id/options_fragment_icon_packs_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/options_fragment_icon_packs_desc"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/options_fragment_customise_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/options_fragment_customise_apps_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/options_fragment_customise_apps"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:id="@+id/options_fragment_customise_apps_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/options_fragment_customise_apps_desc"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/options_fragment_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/options_fragment_about_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/options_fragment_about_slim"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:id="@+id/options_fragment_about_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/options_fragment_about_desc"
                android:textAppearance="@style/TextAppearance.AppCompat"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
